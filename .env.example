# 이 파일을 복사해서 .env 로 만들고 값을 채워 넣으세요. (.env 는 git에 올라가지 않음)

# 서울 열린데이터광장 일반 인증키 (따릉이 bikeList)
SEOUL_API_KEY=

# 공공데이터포털 인증키 (사고다발지역 + 기상청 단기예보, Decoding 키 권장)
DATA_GO_KR_API_KEY=

# Kakao Developers > 앱 > 플랫폼 키
KAKAO_REST_API_KEY=
NEXT_PUBLIC_KAKAO_JS_KEY=

# 서울시 API는 http(8088 포트)만 지원해서 명시적으로 허용해야 함
SEOUL_ALLOW_HTTP=true
